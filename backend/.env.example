# Application Configuration
PORT=3015
NODE_ENV=dev
FUNCTION_NAME=config-studio-backend

# CORS: comma-separated allowed origins (defaults to http://localhost:5176 when unset)
CORS_ORIGINS=http://localhost:5176

# Outbound HTTP timeout in milliseconds (auth-service / admin-service calls)
HTTP_TIMEOUT_MS=10000

# Login rate limiting: max LOGIN_RATE_LIMIT attempts per LOGIN_RATE_TTL_MS window per client
LOGIN_RATE_TTL_MS=60000
LOGIN_RATE_LIMIT=5

# Claim-based authorization (ANY-of, comma-separated). Empty/unset = no claim gating
# (any authenticated user passes) until the auth team publishes the claim names.
# CONFIG_READ_CLAIMS=GET_CONFIG
# CONFIG_WRITE_CLAIMS=POST_CONFIG,PUT_CONFIG,DELETE_CONFIG
# CONFIG_ACTIVATE_CLAIMS=ACTIVATE_CONFIG

# Express trust proxy for the deployment topology ('true', hop count, IP/subnet, or list).
# Required behind a load balancer so request.ip is the real client IP.
# TRUST_PROXY=1

# Tazama Authentication
# Base URL of the auth-service only - the backend appends /v1/auth/login itself
TAZAMA_AUTH_URL=http://localhost:3020
AUTH_PUBLIC_KEY_PATH=public-key.pem
CERT_PATH_PUBLIC=public-key.pem

# Admin Service
ADMIN_SERVICE_URL=http://localhost:5100
